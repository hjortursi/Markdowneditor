{
  "name": "lina-markdown",
  "version": "0.1.0",
  "description": "A quiet Markdown workspace for macOS",
  "private": true,
  "author": "Hjörtur Sigurðsson",
  "main": "dist/main/index.cjs",
  "scripts": {
    "build": "tsc --noEmit && vite build && node scripts/build-main.mjs",
    "start": "npm run build && electron .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "npm run build && playwright test",
    "package": "npm run build && electron-builder --mac --arm64"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "@codemirror/state": "^6.5.0",
    "@codemirror/view": "^6.38.0",
    "@codemirror/commands": "^6.8.0",
    "@codemirror/lang-markdown": "^6.3.0",
    "@codemirror/language": "^6.11.0",
    "markdown-it": "^14.1.0",
    "dompurify": "^3.4.0",
    "@phosphor-icons/react": "^2.1.0"
  },
  "devDependencies": {
    "electron": "44.7.0",
    "electron-builder": "26.15.3",
    "vite": "^8.3.0",
    "typescript": "^5.9.0",
    "esbuild": "^0.28.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/node": "^22.0.0",
    "@types/markdown-it": "^14.1.0",
    "vitest": "^4.0.0",
    "jsdom": "^28.0.0",
    "@playwright/test": "^1.63.0"
  },
  "build": {
    "appId": "is.hjortur.lina",
    "productName": "Lína",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "mac": {
      "target": [
        "dir",
        "dmg"
      ],
      "category": "public.app-category.productivity",
      "identity": "-",
      "icon": "assets/icon.icns"
    },
    "dmg": {
      "title": "Lína",
      "sign": false,
      "contents": [
        {
          "x": 140,
          "y": 180
        },
        {
          "x": 420,
          "y": 180,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "afterPack": "scripts/after-pack.cjs"
  },
  "type": "module"
}
